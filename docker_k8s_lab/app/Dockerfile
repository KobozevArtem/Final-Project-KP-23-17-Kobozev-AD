# ==============================
# БЛОК 1. ВЫБОР БАЗОВОГО ОБРАЗА
# ==============================

# Используется облегчённый образ Python 3.11.
# Он содержит среду выполнения Python и занимает меньше места, чем полный образ.
FROM python:3.11-slim


# ==============================
# БЛОК 2. НАСТРОЙКА РАБОЧЕЙ ДИРЕКТОРИИ
# ==============================

# Создаём и устанавливаем рабочую директорию внутри контейнера.
# Все последующие команды будут выполняться в папке /app.
WORKDIR /app


# ==============================
# БЛОК 3. КОПИРОВАНИЕ ФАЙЛА ЗАВИСИМОСТЕЙ
# ==============================

# Сначала копируется requirements.txt.
# Это позволяет Docker использовать кэш при повторной сборке,
# если зависимости не изменились.
COPY requirements.txt .


# ==============================
# БЛОК 4. УСТАНОВКА PYTHON-БИБЛИОТЕК
# ==============================

# Устанавливаем все зависимости проекта из requirements.txt.
# Флаг --no-cache-dir уменьшает размер итогового Docker-образа.
RUN pip install --no-cache-dir -r requirements.txt


# ==============================
# БЛОК 5. КОПИРОВАНИЕ ФАЙЛОВ ПРИЛОЖЕНИЯ
# ==============================

# Копируем все файлы из папки app на хосте
# в рабочую директорию /app внутри контейнера.
COPY . .


# ==============================
# БЛОК 6. УКАЗАНИЕ ПОРТА ПРИЛОЖЕНИЯ
# ==============================

# Документируем, что приложение использует порт 5000.
# Реальный проброс порта выполняется в docker-compose.yml.
EXPOSE 5000


# ==============================
# БЛОК 7. КОМАНДА ЗАПУСКА КОНТЕЙНЕРА
# ==============================

# При запуске контейнера выполняется main.py,
# в котором стартует Flask-приложение.
CMD ["python", "main.py"]
